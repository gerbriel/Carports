##############################################################################
# Quality Metal Carports — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
##############################################################################

# ─── Geo backends (open source, NO API key needed) ───────────────────────────
# Elevation (3D builder site relief) → Open-Elevation. Leave unset to use the
# public instance; for speed/reliability self-host per
# https://github.com/Jorl17/open-elevation/blob/master/docs/host-your-own.md
# then point at it, e.g. http://localhost:8080/api/v1/lookup
# OPEN_ELEVATION_URL=http://localhost:8080/api/v1/lookup
#
# Geocoding (builder's "place on a real address") → Nominatim (OpenStreetMap).
# Leave unset to use the public instance; set to a self-hosted /search endpoint
# for volume (the public one rate-limits ~1 req/sec).
# NOMINATIM_URL=http://localhost:7070/search

# ─── Reviews ─────────────────────────────────────────────────────────────────
# Reviews are BUNDLED with the site — no API, no fetch, no env var. Edit the cards
# in client/src/data/reviews.json (or run: node server/scripts/add-review.mjs) and
# rebuild the client. The headline rating/total in that file are your real Google
# numbers; the cards are whichever reviews you choose to feature.
#
# ─── Google (OPTIONAL — geocoding fallback for the 3-D site map only) ─────────
# Not used for reviews. Only set this if you want Google geocoding instead of the
# free OpenStreetMap/Nominatim default.
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Cal.com (self-hosted booking) ───────────────────────────────────────────
CAL_BASE_URL=https://book.qualitymetalcarportsca.com
CAL_DB_PASSWORD=change_me_strong_password
CAL_NEXTAUTH_SECRET=change_me_32_char_random_string
CAL_ENCRYPTION_KEY=change_me_32_char_random_string

# ─── Plausible Analytics ─────────────────────────────────────────────────────
PLAUSIBLE_BASE_URL=https://analytics.qualitymetalcarportsca.com
PLAUSIBLE_DB_PASSWORD=change_me_strong_password
# Generate with: openssl rand -base64 64
PLAUSIBLE_SECRET_KEY_BASE=change_me_very_long_random_string

# ─── Twenty CRM ──────────────────────────────────────────────────────────────
TWENTY_BASE_URL=https://crm.qualitymetalcarportsca.com
TWENTY_DB_PASSWORD=change_me_strong_password
# Generate with: openssl rand -base64 32
TWENTY_APP_SECRET=change_me_32_char_random_string
# After Twenty is running, get API key from CRM > Settings > API Keys
TWENTY_API_URL=http://twenty-server:3000
TWENTY_API_KEY=your_twenty_api_key_after_setup

# ─── Documenso (quotes & contracts) ─────────────────────────────────────────
DOCUMENSO_BASE_URL=https://docs.qualitymetalcarportsca.com
DOCUMENSO_DB_PASSWORD=change_me_strong_password
DOCUMENSO_NEXTAUTH_SECRET=change_me_32_char_random_string
# Generate with: openssl rand -hex 16
DOCUMENSO_ENCRYPTION_KEY=change_me_32_hex_chars
DOCUMENSO_ENCRYPTION_KEY_2=change_me_32_hex_chars_secondary

# ─── Postiz (social media management) ────────────────────────────────────────
POSTIZ_BASE_URL=https://social.qualitymetalcarportsca.com
POSTIZ_DB_PASSWORD=change_me_strong_password
POSTIZ_JWT_SECRET=change_me_32_char_random_string

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@qualitymetalcarportsca.com
SMTP_PASS=your_smtp_password

# ─── Chatwoot (live chat + customer support) ─────────────────────────────────
CHATWOOT_BASE_URL=https://support.qualitymetalcarportsca.com
CHATWOOT_DB_PASSWORD=change_me_strong_password
# Generate with: openssl rand -base64 64
CHATWOOT_SECRET_KEY_BASE=change_me_very_long_random_string

# ─── Blog ────────────────────────────────────────────────────────────────────
# Blog posts are BUNDLED with the site (no CMS/API). Edit client/src/data/blogPosts.js
# and add images under client/public/blog/, then rebuild the client.

# ─── Vite (React client — prefix with VITE_ to expose to browser) ────────────
# See ONBOARDING.md and the admin → Setup tab for what each one turns on.

# White-label branding (admin header + meta). Optional.
# VITE_BRAND_NAME=QMC
# VITE_BRAND_FULL=Quality Metal Carports

# Booking (Cal.com)
VITE_CAL_URL=https://book.qualitymetalcarportsca.com

# Live chat (Chatwoot) — token from: Chatwoot > Settings > Inboxes > Website inbox.
# Leave the token blank to keep the demo inbox (no live widget).
VITE_CHATWOOT_URL=https://support.qualitymetalcarportsca.com
VITE_CHATWOOT_WEBSITE_TOKEN=your_website_token_here

# Analytics (Plausible) — set the domain to load the real script; otherwise the
# admin's built-in client-side analytics covers the demo.
# VITE_PLAUSIBLE_DOMAIN=qualitymetalcarportsca.com
# VITE_PLAUSIBLE_URL=https://plausible.qualitymetalcarportsca.com

# Server-side service keys (NOT VITE_) live in server/.env: TWENTY_API_URL/KEY,
# DOCUMENSO_API_URL/KEY, POSTIZ_API_URL/KEY, GOOGLE_PLACES_API_KEY (optional).
